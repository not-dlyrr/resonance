{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resonance",
  "version": "0.1.1",
  "identifier": "dev.resonance.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resonance",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 580,
        "decorations": false,
        "backgroundColor": "#17191d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Independent Spotify customization",
    "category": "Music",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0NkNGODgxODdENzFGRjYKUldUMkg5ZUhnZmhzeEJtVHc5dXRmSFpRUkRkNWREU1JyOVJldVdCR0R4bDVmYXdYRk5xYVFnaG8K",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
